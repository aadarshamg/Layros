STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000
# Uncomment if Redis is available (infra/docker-compose.yml); otherwise Medusa
# falls back to its in-memory event bus/workflow/locking modules for dev.
# REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Supabase Postgres — use the direct/session connection string, not the
# transaction pooler (Medusa is a long-running process). Project Settings > Database.
DATABASE_URL=
DB_NAME=leyros

# Supabase Storage (S3-compatible) — Project Settings > Storage > S3 Connection.
# Leave unset to fall back to local disk storage in dev (see medusa-config.ts).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=leyros-media
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_PUBLIC_URL=

# Build context for this Dockerfile is the repo root (see Dockerfile header
# comment), so these paths are relative to the repo root, not this folder.
# BuildKit picks up "<Dockerfile>.dockerignore" automatically when it sits
# next to the Dockerfile it applies to.

**/node_modules
**/.medusa
**/.turbo
**/.next
**/dist
.git
**/*.log

apps/medusa/.env
apps/medusa/.env.*
!apps/medusa/.env.template

apps/storefront/.env
apps/storefront/.env.*
apps/storefront/.vercel
